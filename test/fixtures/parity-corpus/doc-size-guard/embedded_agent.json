{
  "hook": "doc-size-guard.mjs",
  "hook_path": "hooks/doc-size-guard.mjs",
  "event_type": "PostToolUse",
  "scenario_name": "embedded_agent",
  "description": "CLAUDE_CODE_ENTRYPOINT=sdk-py → isEmbeddedAgent() true, passthrough before any check (even with a violation-worthy file).",
  "env": {
    "CLAUDE_PROJECT_DIR": "<isolated_temp_dir>",
    "CLAUDE_CODE_ENTRYPOINT": "sdk-py"
  },
  "disk_state_setup": [
    {
      "path": ".groundwork/plans/doc.md",
      "content": ""
    }
  ],
  "stdin_payload": {
    "tool_name": "Write",
    "tool_input": {
      "file_path": "<isolated_temp_dir>/.groundwork/plans/doc.md"
    }
  },
  "stdout": "",
  "stderr": "",
  "exit_code": 0,
  "decision": "PASS"
}
