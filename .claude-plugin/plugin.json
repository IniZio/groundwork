{
  "name": "groundwork",
  "version": "3.0.0",
  "description": "groundwork — Newman's working conventions as one mode skill, on top of pstack and house-rules",
  "dependencies": [
    {
      "name": "pstack"
    },
    {
      "name": "house-rules",
      "version": "~0.18.0"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT}/src/hooks/piped-exit-code-guard.ts"
          },
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT}/src/hooks/slow-command-timeout-guard.ts"
          }
        ]
      }
    ]
  }
}
