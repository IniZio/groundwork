{
  "name": "groundwork",
  "version": "3.0.1",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "generate:agents": "node --experimental-strip-types scripts/generate-agent-definitions.ts",
    "check:agents": "node --experimental-strip-types scripts/generate-agent-definitions.ts --check",
    "check:pi": "node scripts/check-pi-skills.mjs",
    "check:sep": "node scripts/check-bookkeeping-separation.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:comments": "node scripts/check-comments.mjs",
    "check:spec-lint": "node hooks/spec-lint.mjs",
    "check": "pnpm run check:agents && pnpm run check:pi && pnpm run check:sep && pnpm run check:versions && pnpm run check:spec-lint && pnpm run check:comments && pnpm run check:bundle && pnpm run check:hooks-bundle && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "token-meter": "node hooks/token-meter.mjs",
    "build:gw": "bun build --compile --target=bun src/gw/cli/main.ts --outfile dist/gw",
    "build:bundle": "node scripts/build-bundle.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "build:hooks-bundle": "node scripts/build-hooks-bundle.mjs",
    "check:hooks-bundle": "node scripts/check-hooks-bundle.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@earendil-works/pi-ai": ">=0.75.0",
    "@earendil-works/pi-coding-agent": ">=0.75.0",
    "@earendil-works/pi-tui": ">=0.75.0",
    "@sinclair/typebox": "^0.34.49",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "pi-subagents": "^0.27.0",
    "yaml": "^2.8.3",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "patch-package": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pi": {
    "extensions": [
      "./pi/pi.ts"
    ],
    "skills": [
      "./.pi/skills"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
