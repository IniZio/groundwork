#!/bin/bash
# commit-msg hook: validates conventional commits format (type: subject)

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

if [ -z "$commit_msg" ]; then
  echo "ERROR: Commit message cannot be empty." >&2
  exit 1
fi

first_line=$(echo "$commit_msg" | head -n1)

if echo "$first_line" | grep -qE '^(fixup|squash)! '; then
  exit 0
fi

valid_types="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"

if ! echo "$first_line" | grep -qE "^(${valid_types})(\([a-zA-Z0-9._-]+\))?!?: .+$"; then
  echo "ERROR: Commit message does not follow conventional commits format." >&2
  echo "" >&2
  echo "Expected: type[(scope)][!]: subject" >&2
  echo "  type:    feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert" >&2
  echo "  scope:   optional, alphanumeric (e.g. api, core, ui)" >&2
  echo "  !:       optional, marks breaking change" >&2
  echo "  subject: brief description" >&2
  echo "" >&2
  echo "Got: ${first_line}" >&2
  exit 1
fi

subject=$(echo "$first_line" | sed -E 's/^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._-]+\))?!?: //')
subject_len=${#subject}

if [ "$subject_len" -gt 72 ]; then
  echo "ERROR: Subject line exceeds 72 characters (${subject_len})." >&2
  exit 1
fi

body_lines=$(echo "$commit_msg" | tail -n +2 | grep -v '^$' | head -1)
if [ -n "$body_lines" ]; then
  second_line=$(echo "$commit_msg" | sed -n '2p')
  if [ -n "$second_line" ]; then
    echo "ERROR: Second line must be blank (separates subject from body)." >&2
    exit 1
  fi
fi

exit 0
