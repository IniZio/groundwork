{
  "hook": "keyword-router.mjs",
  "hook_path": "hooks/keyword-router.mjs",
  "event_type": "UserPromptSubmit",
  "scenario_name": "false_positive_bare_pr",
  "description": "Bare \"PR\" without # → git-master must NOT be triggered (pattern narrowed to \"PR #N\" or \"pull request\"); may still hit advisor via \"review\"",
  "env": {
    "CLAUDE_CODE_SESSION_ID": "<fixed>",
    "CLAUDE_PROJECT_DIR": "<scrubbed>",
    "CLAUDE_PLUGIN_ROOT": "<scrubbed>"
  },
  "disk_state_setup": [],
  "stdin_payload": {
    "prompt": "I sent the PR for review",
    "role": "user"
  },
  "stdout": "{\"continue\":true}\n",
  "stderr": "",
  "exit_code": 0,
  "decision": "NO-SIGNAL"
}
