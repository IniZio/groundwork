{
  "name": "house-rules",
  "version": "0.1.0",
  "description": "house-rules — code-quality rule engine: guard codebase health against vibe-coded bloat",
  "author": {
    "name": "Newman",
    "email": "newman.kcchow@gmail.com"
  },
  "repository": "https://github.com/IniZio/groundwork",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bun ${CLAUDE_PLUGIN_ROOT}/src/hooks/comment-density-gate.ts" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "bun ${CLAUDE_PLUGIN_ROOT}/src/hooks/comment-density-gate.ts" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bun ${CLAUDE_PLUGIN_ROOT}/src/hooks/guard.ts" }
        ]
      }
    ]
  }
}
