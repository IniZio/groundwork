{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2024"
    ],
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "types": [
      "bun-types"
    ]
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "plugins/*/src/**/*",
    "plugins/*/test/**/*",
    "plugins/*/rules/**/*",
    "plugins/*/scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
