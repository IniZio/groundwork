{
  "hook": "doc-size-guard.mjs",
  "hook_path": "hooks/doc-size-guard.mjs",
  "event_type": "PostToolUse",
  "scenario_name": "edit_tool_violation",
  "description": "Edit tool (in guarded set): plan file over budget, missing both structural elements — violation.",
  "env": {
    "CLAUDE_PROJECT_DIR": "<isolated_temp_dir>"
  },
  "disk_state_setup": [
    {
      "path": ".groundwork/plans/doc.md",
      "content": ""
    }
  ],
  "stdin_payload": {
    "tool_name": "Edit",
    "tool_input": {
      "file_path": "<isolated_temp_dir>/.groundwork/plans/doc.md"
    }
  },
  "stdout": "doc-size-guard: violation\n  path:    <isolated_temp_dir>/.groundwork/plans/doc.md\n  class:   plan\n  tokens:  ~3143 (budget 3000)\n  missing: section-anchor\n",
  "stderr": "",
  "exit_code": 0,
  "decision": "WARN"
}
