{
  "hook": "doc-size-guard.mjs",
  "hook_path": "hooks/doc-size-guard.mjs",
  "event_type": "PostToolUse",
  "scenario_name": "plan_under_budget",
  "description": "plan file 10499 bytes → ceil(10499/3.5)=3000 tokens ≤ 3000 budget — passthrough.",
  "env": {
    "CLAUDE_PROJECT_DIR": "<isolated_temp_dir>"
  },
  "disk_state_setup": [
    {
      "path": ".groundwork/plans/doc.md",
      "content": ""
    }
  ],
  "stdin_payload": {
    "tool_name": "Write",
    "tool_input": {
      "file_path": "<isolated_temp_dir>/.groundwork/plans/doc.md"
    }
  },
  "stdout": "",
  "stderr": "",
  "exit_code": 0,
  "decision": "PASS"
}
