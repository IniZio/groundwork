type(scope): subject

# Types:    feat | fix | docs | style | refactor | perf | test | build | ci | chore | revert
# scope:    optional — alphanumeric, dots, hyphens, commas, underscores (e.g. hooks,lib or gw)
# subject:  72 chars max (after "type(scope): " prefix), imperative mood
#
# No body — subject line only.
#
# Attribution trailers (Claude-Session:, Co-Authored-By: Claude) are stripped automatically.
