#!/usr/bin/env bash
# bin/gw-hook — run the gw CLI from source (TypeScript, no compile step).
#
# Symlink this file onto your PATH once:
#   ln -s /path/to/groundwork/bin/gw-hook ~/.local/bin/gw-hook
#
# The wrapper resolves its own real location (following symlinks), then runs
# src/gw/cli/main.ts relative to that, so the symlink never goes stale on upgrades.
#
# Works for both local dev installs (stable repo path) and versioned plugin
# cache installs (readlink follows the symlink to the real versioned file).
#
# Prefers dist/gw.mjs (committed JS bundle, all deps inlined) when present — no
# node_modules needed. Falls back to src/gw/cli/main.ts for local dev (where
# node_modules IS present). Both targets require bun: node cannot remap the
# NodeNext .js import specifiers and dist/gw.mjs is a --target=bun bundle.
#
# Runtime resolution (bun-only, deterministic order):
#   $GW_BUN (if set and executable) → bun on PATH → well-known locations:
#   ~/.bun/bin, mise shims, mise installs, ~/.local/bin, /usr/local/bin,
#   /opt/homebrew/bin. Exits 1 with a stderr diagnostic when bun is not found.
#
# TYPE SAFETY NOTE: bun strips types WITHOUT type-checking them.
# Run `pnpm run check` to catch type errors. Do NOT add a tsc call here —
# it would add seconds to every hook invocation.
#
# STDOUT PURITY: this shim emits NOTHING to stdout. All diagnostics go to
# stderr. Hook protocols communicate via JSON on stdout; a single stray byte
# (e.g. a bun/node notice) corrupts the protocol. The `exec` call replaces
# this process, so the child inherits stdin/stdout/stderr directly — no
# wrapping, no piping, no buffering.

_SELF="${BASH_SOURCE[0]}"

# Follow symlinks portably (readlink -f on Linux, fallback for macOS/other)
if command -v readlink >/dev/null 2>&1; then
  _REAL=$(readlink -f "$_SELF" 2>/dev/null || readlink "$_SELF" 2>/dev/null || echo "$_SELF")
else
  _REAL="$_SELF"
fi
_DIR=$(dirname "$_REAL")
_MAIN="$_DIR/../src/gw/cli/main.ts"
_BUNDLE="$_DIR/../dist/gw.mjs"

# Resolve bun: PATH first, then well-known install locations. A launcher that
# inherits a non-login PATH (a terminal-multiplexer pane, a GUI-spawned editor)
# can miss a perfectly good bun that a login shell would have found.
_BUN=""
if [ -n "$GW_BUN" ] && [ -x "$GW_BUN" ]; then
  _BUN="$GW_BUN"
elif command -v bun >/dev/null 2>&1; then
  _BUN=$(command -v bun)
else
  for _cand in \
    "$HOME/.bun/bin/bun" \
    "$HOME/.local/share/mise/shims/bun" \
    "$HOME/.local/share/mise/installs/bun/latest/bin/bun" \
    "$HOME/.local/bin/bun" \
    "/usr/local/bin/bun" \
    "/opt/homebrew/bin/bun"; do
    if [ -x "$_cand" ]; then
      _BUN="$_cand"
      break
    fi
  done
fi

if [ -n "$_BUN" ]; then
  if [ -f "$_BUNDLE" ]; then
    # GW_REPO_ROOT tells the bundle where the repo root is — import.meta.url
    # resolves to dist/gw.mjs inside a bundle, not the original source file,
    # so ../../../ navigation would land outside the repo. Source files that
    # need the repo root check GW_REPO_ROOT first.
    GW_REPO_ROOT="$_DIR/.." exec "$_BUN" run "$_BUNDLE" "$@"
  else
    exec "$_BUN" run "$_MAIN" "$@"
  fi
fi

# No bun. Do NOT fall through to node: `node --experimental-strip-types` cannot
# remap the NodeNext ".js" import specifiers in src/gw/** to ".ts", and
# dist/gw.mjs is a --target=bun bundle. Both routes crash — the node one with a
# raw ESM resolver stack that names router.js and never mentions bun. Report the
# real cause instead.
echo "gw-hook: bun not found — the groundwork gw hooks require bun." >&2
echo "gw-hook: searched PATH, \$GW_BUN, ~/.bun/bin, ~/.local/share/mise/shims," >&2
echo "gw-hook: ~/.local/share/mise/installs/bun/latest/bin, ~/.local/bin, /usr/local/bin, /opt/homebrew/bin." >&2
echo "gw-hook: install bun (https://bun.sh), add its directory to PATH, or set GW_BUN=/absolute/path/to/bun." >&2
echo "gw-hook: node cannot substitute — src/gw/** uses NodeNext '.js' specifiers that type-stripping does not remap to '.ts'." >&2
exit 1
