{
  "name": "groundwork",
  "version": "2.3.1",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "generate:agents": "node --experimental-strip-types scripts/generate-agent-definitions.ts",
    "check:agents": "node --experimental-strip-types scripts/generate-agent-definitions.ts --check",
    "check": "pnpm run check:agents && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "patch-package",
    "install:kimi": "scripts/install-kimi.sh"
  },
  "dependencies": {
    "@earendil-works/pi-ai": ">=0.75.0",
    "@earendil-works/pi-coding-agent": ">=0.75.0",
    "@earendil-works/pi-tui": ">=0.75.0",
    "@sinclair/typebox": "^0.34.49",
    "js-yaml": "^4.1.0",
    "yaml": "^2.8.3",
    "pi-subagents": "^0.27.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "patch-package": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pi": {
    "extensions": [
      "./pi/pi.ts"
    ],
    "skills": [
      "./.pi/skills"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
