{
  "types": {
    "motive": {
      "tier": "working",
      "generates": ".groundwork/work/{slug}/motive.md",
      "description": "Agent view of the charter: objective, decisions, open questions",
      "instruction": "One per unit of work; record decisions via $GW event append; holds AC and agent detail",
      "frontmatter": {
        "type": "object",
        "required": [
          "created",
          "status"
        ],
        "properties": {
          "created": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "enum": [
              "active",
              "complete",
              "abandoned"
            ]
          }
        }
      },
      "headings": [
        "Objective",
        "Decisions",
        "Open questions"
      ],
      "template": "templates/doc-types/motive.md"
    },
    "spec": {
      "tier": "working",
      "generates": ".groundwork/work/{slug}/spec.md",
      "description": "Agent view of the spec: requirements and AC, folded into durable docs",
      "instruction": "Set folds_into to the durable doc, or none with a reason; holds AC",
      "frontmatter": {
        "type": "object",
        "required": [
          "folds_into"
        ],
        "properties": {
          "folds_into": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "if": {
          "properties": {
            "folds_into": {
              "const": "none"
            }
          },
          "required": [
            "folds_into"
          ]
        },
        "then": {
          "required": [
            "reason"
          ]
        }
      },
      "headings": [
        "Purpose",
        "Requirements"
      ],
      "template": "templates/doc-types/spec.md"
    },
    "issue": {
      "tier": "working",
      "generates": ".groundwork/work/{slug}/tickets/{nn}-{name:kebab}.md",
      "description": "One actionable unit of work, tracked in Obsidian properties",
      "instruction": "Number issues with a two-digit prefix; track state in frontmatter",
      "frontmatter": {
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "triage",
              "needs-info",
              "todo",
              "in-progress",
              "done",
              "canceled"
            ]
          },
          "assignee": {
            "type": "string",
            "enum": [
              "agent",
              "human"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "urgent",
              "high",
              "medium",
              "low",
              "none"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parent": {
            "type": "string"
          },
          "blocked_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          },
          "created": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "headings": [],
      "template": "templates/doc-types/issue.md"
    },
    "map": {
      "tier": "working",
      "generates": ".groundwork/work/{slug}/map.md",
      "description": "Overview map of the work and its parts",
      "instruction": "Keep to a short overview; link issues and docs",
      "frontmatter": {
        "type": "object"
      },
      "headings": [
        "Overview"
      ],
      "template": "templates/doc-types/map.md"
    },
    "research": {
      "tier": "working",
      "generates": ".groundwork/work/{slug}/research/{name:kebab}.md",
      "description": "Investigation of one question with graded confidence",
      "instruction": "State the question and confidence in frontmatter",
      "frontmatter": {
        "type": "object",
        "required": [
          "question",
          "confidence"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      },
      "headings": [
        "Question",
        "Findings"
      ],
      "template": "templates/doc-types/research.md"
    },
    "plan": {
      "tier": "working",
      "generates": ".groundwork/work/{slug}/plan.md",
      "description": "Ordered steps to deliver the work",
      "instruction": "List steps; update as the work changes",
      "frontmatter": {
        "type": "object"
      },
      "headings": [
        "Steps"
      ],
      "template": "templates/doc-types/plan.md"
    },
    "design": {
      "tier": "working",
      "generates": ".groundwork/work/{slug}/design.md",
      "description": "Agent view of the design: context and chosen approach",
      "instruction": "Explain context first, then the design; holds agent detail and AC",
      "frontmatter": {
        "type": "object"
      },
      "headings": [
        "Context",
        "Design"
      ],
      "template": "templates/doc-types/design.md"
    },
    "handoff": {
      "tier": "working",
      "generates": ".groundwork/work/{slug}/handoff.md",
      "description": "State for the next session: done and next",
      "instruction": "Write when pausing so a successor can resume",
      "frontmatter": {
        "type": "object"
      },
      "headings": [
        "Done",
        "Next"
      ],
      "template": "templates/doc-types/handoff.md"
    },
    "evidence": {
      "tier": "working",
      "generates": ".groundwork/work/{slug}/evidence/{name:kebab}.md",
      "description": "Captured proof that a requirement is met",
      "instruction": "One file per proof; no template",
      "frontmatter": {
        "type": "object"
      },
      "headings": [
        "Evidence"
      ]
    },
    "out-of-scope": {
      "tier": "working",
      "generates": ".groundwork/work/{slug}/out-of-scope.md",
      "description": "Ideas and requests deliberately not done",
      "instruction": "Record rejected scope here, not in .out-of-scope/",
      "frontmatter": {
        "type": "object"
      },
      "headings": [
        "Out of scope"
      ],
      "template": "templates/doc-types/out-of-scope.md"
    },
    "lessons": {
      "tier": "working",
      "generates": ".groundwork/work/{slug}/lessons.md",
      "description": "Lessons learned during the work",
      "instruction": "Capture lessons here, not in a lessons/ folder",
      "frontmatter": {
        "type": "object"
      },
      "headings": [
        "Lessons"
      ],
      "template": "templates/doc-types/lessons.md"
    },
    "adr": {
      "tier": "working",
      "generates": ".groundwork/adr/{nnnn}-{name:kebab}.md",
      "description": "Agent-view decision record that can span motives: context, decision, rejected alternatives",
      "instruction": "Number with a four-digit prefix; link it from a DECISION event via $GW event append --type DECISION --data '{\"adr\":\"<path>\"}'; supersede an accepted record instead of editing it; a format-only migration (frontmatter or headings) may edit an accepted record",
      "frontmatter": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "superseded"
            ]
          },
          "superseded_by": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "if": {
          "properties": {
            "status": {
              "const": "superseded"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "required": [
            "superseded_by"
          ]
        }
      },
      "headings": [
        "Context",
        "Decision",
        "Rejected alternatives",
        "Consequences"
      ],
      "template": "templates/doc-types/adr.md"
    },
    "pr-body": {
      "tier": "working",
      "generates": ".groundwork/work/{slug}/pr-body.md",
      "description": "Draft PR body: the human view of this change, reviewed before implementation and published as the PR description",
      "instruction": "Only what could flip a reviewer's yes/no; Summary, Why, Changes and Impact are approved at H1/H2, so fill Review focus and Proof as work lands",
      "frontmatter": {
        "type": "object"
      },
      "headings": [
        "Summary",
        "Why",
        "Changes",
        "Impact",
        "Review focus",
        "Proof"
      ],
      "template": "templates/doc-types/pr-body.md"
    }
  },
  "forbidden": [
    {
      "pattern": "**/doc/adr/**",
      "redirect": "Agent-view decision records go in `.groundwork/adr/{nnnn}-{name:kebab}.md`; link with `$GW event append --type DECISION --data '{\"adr\":\"<path>\"}'`"
    },
    {
      "pattern": "**/docs/adr/**",
      "redirect": "Agent-view decision records go in `.groundwork/adr/{nnnn}-{name:kebab}.md`; link with `$GW event append --type DECISION --data '{\"adr\":\"<path>\"}'`"
    },
    {
      "pattern": ".scratch/**",
      "redirect": "Use `.groundwork/work/{slug}/`"
    },
    {
      "pattern": ".out-of-scope/**",
      "redirect": "Use `.groundwork/work/{slug}/out-of-scope.md`"
    },
    {
      "pattern": "lessons/**",
      "redirect": "Use `.groundwork/work/{slug}/lessons.md`"
    },
    {
      "pattern": "learning-records/**",
      "redirect": "Use `.groundwork/work/{slug}/lessons.md`"
    },
    {
      "pattern": "to-questionnaire-*.md",
      "redirect": "Use `.groundwork/work/{slug}/`"
    },
    {
      "pattern": "**/to-questionnaire-*.md",
      "redirect": "Use `.groundwork/work/{slug}/`"
    },
    {
      "pattern": "doc/*/motive.md",
      "redirect": "doc/ describes the current code only; draft change intent in `.groundwork/work/{slug}/pr-body.md`"
    },
    {
      "pattern": "doc/*/spec.md",
      "redirect": "doc/ describes the current code only; draft change intent in `.groundwork/work/{slug}/pr-body.md`"
    },
    {
      "pattern": "doc/*/tickets/**",
      "redirect": "doc/ describes the current code only; draft change intent in `.groundwork/work/{slug}/pr-body.md`"
    },
    {
      "pattern": "docs/*/motive.md",
      "redirect": "doc/ describes the current code only; draft change intent in `.groundwork/work/{slug}/pr-body.md`"
    },
    {
      "pattern": "docs/*/spec.md",
      "redirect": "doc/ describes the current code only; draft change intent in `.groundwork/work/{slug}/pr-body.md`"
    },
    {
      "pattern": "docs/*/tickets/**",
      "redirect": "doc/ describes the current code only; draft change intent in `.groundwork/work/{slug}/pr-body.md`"
    }
  ]
}
