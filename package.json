{
  "name": "groundwork",
  "version": "3.8.2",
  "description": "groundwork — Newman's working conventions on top of pstack, plus house-rules",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "test:mod": "claude plugin validate . && d=$(mktemp -d) && mkdir -p \"$d/.claude-plugin\" \"$d/src\" && cp .claude-plugin/plugin.json \"$d/.claude-plugin/\" && cp -r hooks types \"$d/\" && cp -r src/mod \"$d/src/\" && claude plugin test \"$d\"; s=$?; rm -rf \"$d\"; exit $s",
    "gen:validators": "bun scripts/gen-validators.ts",
    "house-rules": "bun plugins/house-rules/src/cli/main.ts"
  },
  "devDependencies": {
    "@derekstride/tree-sitter-sql": "0.3.11",
    "@tree-sitter-grammars/tree-sitter-kotlin": "1.1.0",
    "@tree-sitter-grammars/tree-sitter-toml": "0.7.0",
    "@tree-sitter-grammars/tree-sitter-yaml": "0.7.1",
    "@types/bun": "1.4.2",
    "ajv": "8.20.0",
    "tree-sitter-bash": "0.25.1",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-make": "1.1.1",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "7.0.2",
    "web-tree-sitter": "0.25.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
