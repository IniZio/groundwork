{
  "hook": "doc-read-guard.mjs",
  "hook_path": "hooks/doc-read-guard.mjs",
  "event_type": "PreToolUse",
  "scenario_name": "read_over_budget_deny",
  "description": "Read of a plan-class file (~3143 tokens) exceeding the 3000-token budget with no TOC issued. Hook denies with 'doc toc <path>' guidance (AC 2).",
  "env": {
    "CLAUDE_PROJECT_DIR": "<isolated_temp_dir>"
  },
  "disk_state_setup": [
    {
      "path": ".groundwork/plans/big-plan.md",
      "content_summary": "plan-class file, 11000 bytes (~3143 tokens), over 3000-token budget",
      "content": ""
    }
  ],
  "stdin_payload": {
    "tool_name": "Read",
    "tool_input": {
      "file_path": "<isolated_temp_dir>/.groundwork/plans/big-plan.md"
    },
    "session_id": "parity-corpus-drg-001"
  },
  "stdout": "{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"doc-read-guard: <isolated_temp_dir>/.groundwork/plans/big-plan.md is a 'plan' doc-class file (~3143 tokens, budget 3000).\\nReading it wholesale injects the full file into context. Use progressive disclosure instead:\\n\\n  doc toc <isolated_temp_dir>/.groundwork/plans/big-plan.md\\n\\nThen load only the section you need with:\\n  doc show <isolated_temp_dir>/.groundwork/plans/big-plan.md --section <anchor>\"}}\n",
  "stderr": "",
  "exit_code": 0,
  "decision": "DENY"
}
