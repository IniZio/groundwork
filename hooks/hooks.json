{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task|TaskCreate",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/gw-hook hook agent-model-guard",
            "async": false
          }
        ]
      },
      {
        "matcher": "Agent|Task|TaskCreate",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/gw-hook hook nesting-guard",
            "async": false
          }
        ]
      },
      {
        "matcher": "Read|Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/gw-hook hook ledger-guard",
            "async": false
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/gw-hook hook ledger-bash-guard",
            "async": false
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
