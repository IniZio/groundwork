{
  "hook": "doc-size-guard.mjs",
  "hook_path": "hooks/doc-size-guard.mjs",
  "event_type": "PostToolUse",
  "scenario_name": "narrative_violation",
  "description": "narrative class (doc/*.md, budget 2000 tokens): 7001 bytes → 2001 tokens, missing both elements — violation names narrative class and 2000-token budget.",
  "env": {
    "CLAUDE_PROJECT_DIR": "<isolated_temp_dir>"
  },
  "disk_state_setup": [
    {
      "path": "doc/test-narrative.md",
      "content": ""
    }
  ],
  "stdin_payload": {
    "tool_name": "Write",
    "tool_input": {
      "file_path": "<isolated_temp_dir>/doc/test-narrative.md"
    }
  },
  "stdout": "doc-size-guard: violation\n  path:    <isolated_temp_dir>/doc/test-narrative.md\n  class:   narrative\n  tokens:  ~2001 (budget 2000)\n  missing: section-anchor\n",
  "stderr": "",
  "exit_code": 0,
  "decision": "WARN"
}
