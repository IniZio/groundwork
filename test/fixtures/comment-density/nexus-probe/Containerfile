# Probe-kit guest image — NOT part of nexus. Built by CI with plain
# `docker buildx` and pushed to registry.oursky.dev/nexus-probe-toolchain:<tag>;
# probe.sh runs it via `nexus run "$TOOLCHAIN_REF"` (see README.md
# "Toolchain image flow"). `nexus image build` is not used: its builder VM is
# not wired at the pinned nexus ref ("no builder configured").
#
# All toolchains come from Debian apt (g++, rustc, golang-go) — no external
# tarball downloads, so the build depends only on the Debian mirrors. zig was
# dropped for the probe: its only distribution is ziglang.org tarballs, whose
# download proved flaky in CI (curl 18, transfer closed mid-stream).
FROM debian:bookworm-slim

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
        g++ \
        rustc \
        golang-go \
        ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
