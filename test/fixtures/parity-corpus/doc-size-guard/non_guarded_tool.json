{
  "hook": "doc-size-guard.mjs",
  "hook_path": "hooks/doc-size-guard.mjs",
  "event_type": "PostToolUse",
  "scenario_name": "non_guarded_tool",
  "description": "Read tool is not in the guarded set (write|edit|multiedit) — passthrough before any file check.",
  "env": {
    "CLAUDE_PROJECT_DIR": "<isolated_temp_dir>"
  },
  "disk_state_setup": [
    {
      "path": ".groundwork/plans/doc.md",
      "content": ""
    }
  ],
  "stdin_payload": {
    "tool_name": "Read",
    "tool_input": {
      "file_path": "<isolated_temp_dir>/.groundwork/plans/doc.md"
    }
  },
  "stdout": "",
  "stderr": "",
  "exit_code": 0,
  "decision": "PASS"
}
